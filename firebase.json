{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log"
    ]
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.git/**",
      "**/.venv/**",
      "**/node_modules/**",
      "**/__pycache__/**",
      "data/**",
      "archive/**",
      "outreach/**",
      "scripts/**",
      "tests/**",
      "ops/**",
      "supabase/**",
      "functions/**",
      "docs/**",
      "pages/**",
      "*.py",
      "*.pyc",
      "*.md",
      "*.sh",
      "*.mjs",
      "*.log",
      "*.txt",
      "*.pdf",
      "deploy.sh",
      "firebase-debug.log",
      "vite.config.mjs",
      "babel.config.json",
      "public-index.html",
      "machine-room.html",
      "approval-console.html"
    ],
    "rewrites": [
      {
        "source": "/feedback",
        "destination": "/feedback/index.html"
      },
      {
        "source": "/feedback.html",
        "destination": "/feedback/index.html"
      },
      {
        "source": "/reach",
        "destination": "/connect.html"
      },
      {
        "source": "/connect",
        "destination": "/connect.html"
      },
      {
        "source": "/connect.html",
        "destination": "/connect.html"
      },
      {
        "source": "/scope",
        "destination": "/scope.html"
      },
      {
        "source": "/scope.html",
        "destination": "/scope.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/flow-v4/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/tweaks-panel.jsx",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/docs/**.pdf",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/pdf"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/assets/docs/**.pdf",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/pdf"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment"
          }
        ]
      },
      {
        "source": "/assets/docs/**.rtf",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/rtf"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment"
          }
        ]
      }
    ]
  }
}
